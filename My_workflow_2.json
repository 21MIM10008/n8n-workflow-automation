      "parameters": {
        "jsCode": "try {\n  // Ensure fields exist before using them\n  const name = $input.first().json.Name|| \"Unknown\";\n  const amount = $input.first().json.Amount|| \"0\";\n  const product = $input.first().json.Product || \"Unknown\";\n\n  // Construct the text string\n  const text = `Name: ${name}, Debt: ${amount}, Product: ${product}`;\n\n  // Make the API request to OpenRouter\n  const response = await $http({\n    method: 'POST',\n    url: 'https://openrouter.ai/api/v1/embeddings',\n    headers: {\n      'Authorization':'Bearer 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',\n      'Content-Type': 'application/json'\n    },\n    body: {\n      input: text,\n      model: 'text-embedding-3-small'\n    },\n    responseType: 'json'\n  });\n\n  // Validate API response structure\n  if (!response.data || !response.data.data || !response.data.data[0] || !response.data.data[0].embedding) {\n    throw new Error(\"Unexpected API response format\");\n  }\n\n  // Return the JSON with the vector embedding\n  return { \n    ...$json,\n    vector: response.data.data[0].embedding \n  };\n  \n} catch (error) {\n  console.error(\"Error fetching embeddings:\", error.message);\n  return { ...$json, error: error.message };\n}\n"
      },
